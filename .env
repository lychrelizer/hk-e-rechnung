# --- Anwendung ---
APP_DEBUG=false
CREATOR_TOOL="E-Rechnung Converter"
DEFAULT_PROFILE=EN16931
DEFAULT_PAYMENT_TERMS="Zahlbar innerhalb von 14 Tagen ohne Abzug."

# --- JSON-API: HTTP Basic Auth (Pflicht, sonst wird jede Anfrage abgewiesen) ---
API_USER=api
# Klartext oder Hash aus: php -r 'echo password_hash("geheim", PASSWORD_DEFAULT), PHP_EOL;'
API_PASSWORD=geheim

# Web-Formular ebenfalls mit Basic Auth schützen?
WEB_AUTH_ENABLED=false

# --- Vorbelegung des Verkäufers im Web-Formular (optional) ---
SELLER_NAME=
SELLER_STREET=
SELLER_ZIP=
SELLER_CITY=
SELLER_COUNTRY=DE
SELLER_VAT_ID=
SELLER_TAX_NUMBER=
SELLER_EMAIL=
SELLER_PHONE=
SELLER_CONTACT=
SELLER_IBAN=
SELLER_BIC=
SELLER_ACCOUNT_HOLDER=
